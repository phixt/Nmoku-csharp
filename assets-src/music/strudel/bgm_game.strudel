// bgm_game.strudel —— 对局 BGM（占位骨架，正式创作在此基础上展开）
// 源语义（audio_var.md §二 game）：driving, plucky with walking bass
// 和弦进行：Am7 Fmaj7 Cadd9 G7，每和弦 0.9s → setcps(1/0.9) ≈ 1.11（1 cycle = 1 和弦）
// 播放: 全选复制本文件 → https://strudel.cc/ → Ctrl/Cmd + Enter

setcps(1 / 0.9)

stack(
  // 行走贝斯：源 bassLine walking——下行半音趋近（Am7→A2 G2 F#2 E2 …按和弦各 4 步）
  n("[[a2 g2 fs2 e2],[f2 e2 d2 c2],[c2 b1 a1 g1],[g2 f2 e2 d2]]")
    .s("triangle")
    .attack(.004).release(.12)
    .gain(.09),

  // 和弦：断奏拨奏感（源 sawtooth staccato 音长 35%）
  chord("<Am7 Fmaj7 Cadd9 G7>")
    .s("sawtooth")
    .attack(.006).release(.18).clip(1)
    .gain(.045),

  // 高频琶音：方波（源 square gain 0.03，延迟回声正式版再加）
  n("[[a4 c5 e5 g5],[f4 a4 c5 e5],[c4 e4 g4 d5],[g4 b4 d5 f5]]")
    .s("square")
    .attack(.004).release(.1).clip(1)
    .gain(.02).delay(.18),
)
